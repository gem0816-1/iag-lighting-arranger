{
  "manifest_version": 3,
  "name": "IAG B站时间轴同步",
  "version": "1.0.0",
  "description": "在 IAG 灯光编排和它内嵌的 B 站播放器之间同步播放、暂停和进度。",
  "content_scripts": [
    {
      "matches": ["https://player.bilibili.com/player.html*"],
      "js": ["frame.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
